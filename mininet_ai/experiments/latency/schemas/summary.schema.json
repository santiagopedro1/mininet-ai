{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mininet-ai.org/schemas/link-failure-latency/v2/summary.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object", "unevaluatedProperties": false,
  "required": ["state", "terminal_reason", "counts", "distributions", "rates"],
  "properties": {
    "state": {"enum": ["completed", "aborted", "incomplete"]},
    "terminal_reason": {"$ref": "common.schema.json#/$defs/nullable_id"},
    "counts": {"type": "object", "additionalProperties": false, "required": ["warmup", "measured"], "properties": {"warmup": {"$ref": "#/$defs/counts"}, "measured": {"$ref": "#/$defs/counts"}}},
    "distributions": {"type": "array", "items": {"$ref": "#/$defs/distribution"}},
    "rates": {"type": "array", "items": {"$ref": "#/$defs/rate"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "counts": {"type": "object", "additionalProperties": false, "required": ["requested", "started", "finalized", "cleanup_completed", "unknown", "unstarted", "outcomes"], "properties": {
      "requested": {"$ref": "#/$defs/count"}, "started": {"$ref": "#/$defs/count"}, "finalized": {"$ref": "#/$defs/count"}, "cleanup_completed": {"$ref": "#/$defs/count"}, "unknown": {"$ref": "#/$defs/count"}, "unstarted": {"$ref": "#/$defs/count"},
      "outcomes": {"type": "object", "additionalProperties": false, "required": ["recovered", "timeout", "invalid", "setup_failed", "injection_failed", "no_observed_disruption", "error"], "properties": {
        "recovered": {"$ref": "#/$defs/count"}, "timeout": {"$ref": "#/$defs/count"}, "invalid": {"$ref": "#/$defs/count"}, "setup_failed": {"$ref": "#/$defs/count"}, "injection_failed": {"$ref": "#/$defs/count"}, "no_observed_disruption": {"$ref": "#/$defs/count"}, "error": {"$ref": "#/$defs/count"}
      }}
    }},
    "group": {"type": "object", "additionalProperties": false, "required": ["agent_id", "failed_link", "trial_outcome", "operation_outcome"], "properties": {
      "agent_id": {"$ref": "common.schema.json#/$defs/nullable_id"}, "failed_link": {"anyOf": [{"$ref": "common.schema.json#/$defs/link"}, {"type": "null"}]},
      "trial_outcome": {"anyOf": [{"$ref": "common.schema.json#/$defs/trial_outcome"}, {"type": "null"}]}, "operation_outcome": {"$ref": "common.schema.json#/$defs/nullable_id"}
    }},
    "reasons": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
    "statistic": {"type": ["number", "null"], "minimum": 0},
    "distribution": {"type": "object", "additionalProperties": false, "required": ["metric", "population", "unit", "trial_kind", "group", "complete", "available", "unavailable", "not_applicable", "unavailable_reasons", "not_applicable_reasons", "included", "late_excluded", "count", "mean_seconds", "median_seconds", "min_seconds", "max_seconds"], "properties": {
      "metric": {"enum": ["recovery", "detection", "reasoning", "action_effect", "execution", "verification"]}, "population": {"enum": ["trial", "agent_trial", "action"]}, "unit": {"const": "seconds"}, "trial_kind": {"const": "measured"}, "group": {"$ref": "#/$defs/group"}, "complete": {"type": "boolean"},
      "available": {"$ref": "#/$defs/count"}, "unavailable": {"$ref": "#/$defs/count"}, "not_applicable": {"$ref": "#/$defs/count"}, "included": {"$ref": "#/$defs/count"}, "late_excluded": {"$ref": "#/$defs/count"}, "count": {"$ref": "#/$defs/count"},
      "unavailable_reasons": {"$ref": "#/$defs/reasons"}, "not_applicable_reasons": {"$ref": "#/$defs/reasons"},
      "mean_seconds": {"$ref": "#/$defs/statistic"}, "median_seconds": {"$ref": "#/$defs/statistic"}, "min_seconds": {"$ref": "#/$defs/statistic"}, "max_seconds": {"$ref": "#/$defs/statistic"}
    }},
    "rate": {"type": "object", "additionalProperties": false, "required": ["metric", "trial_kind", "group", "complete", "numerator", "denominator", "value"], "properties": {
      "metric": {"enum": ["recovery_all_started", "recovery_valid_disrupted", "detection_participation", "action_participation"]}, "trial_kind": {"const": "measured"}, "group": {"$ref": "#/$defs/group"}, "complete": {"type": "boolean"}, "numerator": {"$ref": "#/$defs/count"}, "denominator": {"$ref": "#/$defs/count"}, "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
    }}
  }
}
