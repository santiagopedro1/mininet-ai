{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mininet-ai.org/schemas/link-failure-latency/v2/event.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object", "unevaluatedProperties": false,
  "required": ["type", "trial_id", "fault_id", "data"],
  "properties": {
    "trial_id": {"$ref": "common.schema.json#/$defs/nullable_id"},
    "fault_id": {"$ref": "common.schema.json#/$defs/nullable_id"},
    "type": {"type": "string"}, "data": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"type": {"enum": ["operation_started", "operation_completed", "operation_failed", "operation_cancelled"]}, "data": {"$ref": "#/$defs/operation"}}},
    {"properties": {"type": {"const": "trial_started"}, "data": {"$ref": "#/$defs/trial_started"}}},
    {"properties": {"type": {"const": "trial_ended"}, "data": {"$ref": "#/$defs/trial_ended"}}},
    {"properties": {"type": {"const": "observation_ready"}, "data": {"$ref": "#/$defs/ready"}}},
    {"properties": {"type": {"const": "observation"}, "data": {"$ref": "#/$defs/observation"}}},
    {"properties": {"type": {"const": "recognition"}, "data": {"$ref": "#/$defs/recognition"}}},
    {"properties": {"type": {"const": "fault_confirmed"}, "data": {"$ref": "#/$defs/fault"}}},
    {"properties": {"type": {"const": "probe_round"}, "data": {"$ref": "#/$defs/probe"}}},
    {"properties": {"type": {"const": "slot_missed"}, "data": {"$ref": "#/$defs/missed"}}},
    {"properties": {"type": {"const": "recovery_confirmed"}, "data": {"$ref": "#/$defs/recovery"}}},
    {"properties": {"type": {"const": "admission"}, "data": {"$ref": "#/$defs/admission"}}},
    {"properties": {"type": {"const": "admission_closed"}, "data": {"$ref": "#/$defs/reason"}}},
    {"properties": {"type": {"const": "provider_request_started"}, "data": {"$ref": "#/$defs/request"}}},
    {"properties": {"type": {"const": "provider_request_terminal"}, "data": {"$ref": "#/$defs/terminal"}}},
    {"properties": {"type": {"const": "provider_cancel_requested"}, "data": {"$ref": "#/$defs/cancel"}}},
    {"properties": {"type": {"const": "cleanup_completed"}, "data": {"$ref": "#/$defs/cleanup"}}},
    {"properties": {"type": {"const": "recorder_loss"}, "data": {"$ref": "#/$defs/loss"}}},
    {"properties": {"type": {"enum": ["run_finished", "run_aborted"]}, "trial_id": {"type": "null"}, "fault_id": {"type": "null"}, "data": {"$ref": "#/$defs/reason"}}}
  ],
  "$defs": {
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "phase", "agent_id", "invocation_id", "proposal_id", "outcome"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/id"}, "phase": {"$ref": "common.schema.json#/$defs/phase"},
        "agent_id": {"$ref": "common.schema.json#/$defs/nullable_id"}, "invocation_id": {"$ref": "common.schema.json#/$defs/nullable_id"},
        "proposal_id": {"$ref": "common.schema.json#/$defs/nullable_id"}, "outcome": {"$ref": "common.schema.json#/$defs/nullable_id"}
      }
    },
    "trial_started": {"type": "object", "additionalProperties": false, "required": ["trial_kind", "ordinal", "scenario_id", "failed_link"], "properties": {
      "trial_kind": {"$ref": "common.schema.json#/$defs/trial_kind"}, "ordinal": {"type": "integer", "minimum": 1}, "scenario_id": {"$ref": "common.schema.json#/$defs/id"}, "failed_link": {"$ref": "common.schema.json#/$defs/link"}
    }},
    "trial_ended": {"type": "object", "additionalProperties": false, "required": ["outcome", "stage", "reason"], "properties": {
      "outcome": {"$ref": "common.schema.json#/$defs/trial_outcome"}, "stage": {"enum": ["setup", "injection", "response"]}, "reason": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "ready": {"type": "object", "additionalProperties": false, "required": ["source", "agent_id"], "properties": {"source": {"$ref": "common.schema.json#/$defs/id"}, "agent_id": {"$ref": "common.schema.json#/$defs/id"}}},
    "endpoints": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"enum": ["up", "down", "unknown"]}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["observation_id", "source", "scheduled_ns", "started_ns", "completed_ns", "endpoint_states"], "properties": {
      "observation_id": {"$ref": "common.schema.json#/$defs/id"}, "source": {"$ref": "common.schema.json#/$defs/id"},
      "scheduled_ns": {"$ref": "common.schema.json#/$defs/tick"}, "started_ns": {"$ref": "common.schema.json#/$defs/tick"}, "completed_ns": {"$ref": "common.schema.json#/$defs/tick"}, "endpoint_states": {"$ref": "#/$defs/endpoints"}
    }},
    "recognition": {"type": "object", "additionalProperties": false, "required": ["agent_id", "observation_record_id", "event_id", "source"], "properties": {
      "agent_id": {"$ref": "common.schema.json#/$defs/id"}, "observation_record_id": {"$ref": "common.schema.json#/$defs/id"}, "event_id": {"$ref": "common.schema.json#/$defs/id"}, "source": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "fault": {"type": "object", "additionalProperties": false, "required": ["observation_record_id"], "properties": {"observation_record_id": {"$ref": "common.schema.json#/$defs/id"}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["probe_round_id", "purpose", "slot", "scheduled_ns", "started_ns", "completed_ns", "directions", "link_before", "link_after", "late"], "properties": {
      "probe_round_id": {"$ref": "common.schema.json#/$defs/id"}, "purpose": {"enum": ["baseline", "disruption", "recovery"]}, "slot": {"type": "integer", "minimum": 0},
      "scheduled_ns": {"$ref": "common.schema.json#/$defs/tick"}, "started_ns": {"$ref": "common.schema.json#/$defs/tick"}, "completed_ns": {"$ref": "common.schema.json#/$defs/tick"},
      "directions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["source", "destination", "success", "observation_id"], "properties": {
        "source": {"enum": ["h1", "h2"]}, "destination": {"enum": ["h1", "h2"]}, "success": {"type": ["boolean", "null"]}, "observation_id": {"$ref": "common.schema.json#/$defs/id"}
      }}},
      "link_before": {"$ref": "#/$defs/endpoints"}, "link_after": {"$ref": "#/$defs/endpoints"}, "late": {"type": "boolean"}
    }},
    "missed": {"type": "object", "additionalProperties": false, "required": ["schedule", "slot", "scheduled_ns", "reason"], "properties": {
      "schedule": {"enum": ["probe", "observation"]}, "slot": {"type": "integer", "minimum": 0}, "scheduled_ns": {"$ref": "common.schema.json#/$defs/tick"}, "reason": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["probe_record_ids", "first_success_record_id"], "properties": {
      "probe_record_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}}, "first_success_record_id": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "admission": {"type": "object", "additionalProperties": false, "required": ["kind", "operation_id", "agent_id", "invocation_id", "proposal_id", "accepted"], "properties": {
      "kind": {"enum": ["invocation", "action"]}, "operation_id": {"$ref": "common.schema.json#/$defs/id"}, "agent_id": {"$ref": "common.schema.json#/$defs/id"}, "invocation_id": {"$ref": "common.schema.json#/$defs/id"}, "proposal_id": {"$ref": "common.schema.json#/$defs/nullable_id"}, "accepted": {"type": "boolean"}
    }},
    "reason": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"$ref": "common.schema.json#/$defs/id"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "provider_request_id", "invocation_id", "agent_id", "provider"], "properties": {
      "request_id": {"$ref": "common.schema.json#/$defs/id"}, "provider_request_id": {"$ref": "common.schema.json#/$defs/nullable_id"}, "invocation_id": {"$ref": "common.schema.json#/$defs/id"}, "agent_id": {"$ref": "common.schema.json#/$defs/id"}, "provider": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "terminal": {"type": "object", "additionalProperties": false, "required": ["request_id", "evidence", "source"], "properties": {
      "request_id": {"$ref": "common.schema.json#/$defs/id"}, "evidence": {"enum": ["normal_response", "remote_termination"]}, "source": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "cancel": {"type": "object", "additionalProperties": false, "required": ["request_id", "reason"], "properties": {"request_id": {"$ref": "common.schema.json#/$defs/id"}, "reason": {"$ref": "common.schema.json#/$defs/id"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["outcome", "network_absent", "workers_stopped", "provider_contained", "reason"], "properties": {
      "outcome": {"$ref": "common.schema.json#/$defs/cleanup_outcome"}, "network_absent": {"type": ["boolean", "null"]}, "workers_stopped": {"type": ["boolean", "null"]}, "provider_contained": {"type": ["boolean", "null"]}, "reason": {"$ref": "common.schema.json#/$defs/id"}
    }},
    "loss": {"type": "object", "additionalProperties": false, "required": ["reason", "lost_count"], "properties": {"reason": {"$ref": "common.schema.json#/$defs/id"}, "lost_count": {"type": "integer", "minimum": 1}}}
  }
}
